<section class="section" data-tabs>
  <div class="wrap">
    <div class="tabs-head">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" id="tab-{{ block.id }}" aria-controls="panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
        {%- endfor -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        {% render 'product-slider', products: block.settings.collection.products, limit: section.settings.limit %}
        <div class="center"><a class="btn btn--ghost" href="{{ block.settings.collection.url }}">Ver coleção completa {% render 'icon', name: 'arrow-right', size: 16 %}</a></div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Abas de produtos","settings":[
 {"type":"text","id":"heading","label":"Título"},
 {"type":"range","id":"limit","label":"Produtos por aba","min":4,"max":24,"step":1,"default":12}],
"blocks":[{"type":"tab","name":"Aba","settings":[{"type":"text","id":"label","label":"Nome"},{"type":"collection","id":"collection","label":"Coleção"}]}],
"max_blocks":5,
"presets":[{"name":"Abas de produtos","blocks":[{"type":"tab","settings":{"label":"Lançamentos"}},{"type":"tab","settings":{"label":"Mais procurados"}},{"type":"tab","settings":{"label":"Exclusivos"}}]}]}
{% endschema %}
