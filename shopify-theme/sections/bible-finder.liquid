<section class="section">
  <div class="wrap">
    <div class="finder">
      <div class="finder__intro">
        <p class="eyebrow eyebrow--gold">{% render 'icon', name: 'bible', size: 16 %} {{ section.settings.eyebrow }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <ul class="finder__points"><li>{% render 'icon', name: 'check', size: 18 %} NVI, ACF, NTLH e A21</li><li>{% render 'icon', name: 'check', size: 18 %} Letra tradicional, grande e gigante</li><li>{% render 'icon', name: 'check', size: 18 %} Estudo, devocional e journaling</li></ul>
      </div>
      {% render 'finder-form', base_url: section.settings.collection.url, button: section.settings.button %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Encontre sua Bíblia","settings":[
 {"type":"text","id":"eyebrow","label":"Sobretítulo","default":"Encontre sua Bíblia"},
 {"type":"text","id":"heading","label":"Título","default":"A Bíblia certa em 4 perguntas"},
 {"type":"textarea","id":"text","label":"Texto","default":"São mais de 250 Bíblias no catálogo. Responda rapidinho e mostramos as que combinam com você."},
 {"type":"text","id":"button","label":"Botão","default":"Ver Bíblias para mim"},
 {"type":"collection","id":"collection","label":"Coleção de Bíblias"}],
"presets":[{"name":"Encontre sua Bíblia"}]}
{% endschema %}
