<section class="section">
  <div class="wrap">
    {% render 'section-heading', title: section.settings.heading, eyebrow: section.settings.eyebrow %}
    <div class="cats">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>{% render 'collection-card', collection: block.settings.collection, image: block.settings.image, title: block.settings.title, subtitle: block.settings.subtitle %}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Grade de categorias","settings":[
 {"type":"text","id":"eyebrow","label":"Sobretítulo","default":"Explore"},
 {"type":"text","id":"heading","label":"Título","default":"Encontre sua próxima leitura"}],
"blocks":[{"type":"category","name":"Categoria","settings":[
 {"type":"collection","id":"collection","label":"Coleção"},
 {"type":"image_picker","id":"image","label":"Imagem (opcional)"},
 {"type":"text","id":"title","label":"Título"},
 {"type":"text","id":"subtitle","label":"Subtítulo"}]}],
"max_blocks":8,
"presets":[{"name":"Grade de categorias","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}
{% endschema %}
