<section class="section">
  <div class="wrap nf">
    <div class="nf__art" aria-hidden="true">
      <span class="nf__code">4<span class="nf__book">{% render 'icon', name: 'book', size: 96 %}</span>4</span>
    </div>
    <h1 class="h1">{{ 'not_found.title' | t }}</h1>
    <p class="muted">{{ 'not_found.text' | t }}</p>
    {% render 'search-form', size: 'lg', id: 'nf' %}
    <div class="chips chips--center">
      {%- for link in linklists[section.settings.menu].links -%}<a class="chip" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </div>
    {%- assign t1 = 'not_found.back' | t -%}
    {% render 'button', label: t1, link: routes.root_url, style: 'ghost' %}
  </div>
</section>
{% schema %}
{"name":"Página 404","settings":[{"type":"link_list","id":"menu","label":"Atalhos (menu)","default":"main-menu"}]}
{% endschema %}
