<section class="hero" data-hero aria-roledescription="carousel">
  <div class="hero__track">
    {%- for block in section.blocks -%}
      <div class="hero__slide hero__slide--{{ block.settings.tone }}{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }} aria-label="{{ 'accessibility.slide' | t: index: forloop.index }}">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1900 | image_tag: class: 'hero__img', loading: 'eager', widths: '750, 1100, 1500, 1900', alt: '' }}
        {%- else -%}
          <img class="hero__img" src="{{ block.settings.fallback | asset_url }}" alt="" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- endif -%}
        <div class="wrap hero__content">
          {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="hero__title">{{ block.settings.heading }}</h2>
          <p class="hero__text">{{ block.settings.text }}</p>
          <div class="hero__ctas">
            {% render 'button', label: block.settings.btn_label, link: block.settings.btn_link, style: 'accent', icon: 'arrow-right' %}
            {% render 'button', label: block.settings.btn2_label, link: block.settings.btn2_link, style: 'light' %}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">{%- for block in section.blocks -%}<button type="button" class="{% if forloop.first %}is-on{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide' | t: index: forloop.index }}"></button>{%- endfor -%}</div>
  {%- endif -%}
</section>
{% schema %}
{"name":"Banner principal","settings":[{"type":"range","id":"autoplay","label":"Troca automática (s, 0 = desliga)","min":0,"max":12,"step":1,"default":6}],
"blocks":[{"type":"slide","name":"Slide","settings":[
 {"type":"image_picker","id":"image","label":"Imagem (1900x620)"},
 {"type":"text","id":"fallback","label":"Imagem padrão (asset)","default":"tn-banner-hero-biblias.jpg"},
 {"type":"select","id":"tone","label":"Texto","options":[{"value":"light","label":"Claro"},{"value":"dark","label":"Escuro"}],"default":"light"},
 {"type":"text","id":"eyebrow","label":"Sobretítulo"},
 {"type":"text","id":"heading","label":"Título","default":"A Palavra para cada dia"},
 {"type":"textarea","id":"text","label":"Texto","default":"Bíblias em NVI, ACF e NTLH com letra confortável e acabamentos que duram."},
 {"type":"text","id":"btn_label","label":"Botão","default":"Ver Bíblias"},
 {"type":"url","id":"btn_link","label":"Link do botão"},
 {"type":"text","id":"btn2_label","label":"Botão secundário"},
 {"type":"url","id":"btn2_link","label":"Link secundário"}]}],
"max_blocks":5,
"presets":[{"name":"Banner principal","blocks":[{"type":"slide"}]}]}
{% endschema %}
