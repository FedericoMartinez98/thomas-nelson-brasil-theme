<article class="section section--tight">
  <div class="wrap wrap--narrow">
    {% render 'breadcrumbs' %}
    <p class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }} · {{ article.author }}</p>
    <h1 class="h1">{{ article.title }}</h1>
    {%- if article.image -%}<div class="article__img">{{ article.image | image_url: width: 1400 | image_tag: alt: article.title }}</div>{%- endif -%}
    <div class="rte article__body">{{ article.content }}</div>
    <div class="pdp__share">
      <span>{{ 'products.share' | t }}:</span>
      <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp', size: 20 %}</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 20 %}</a>
    </div>
    <a class="link-arrow" href="{{ blog.url }}">{% render 'icon', name: 'chevron-left', size: 16 %} {{ 'blog.back' | t }}</a>
  </div>
</article>
{% schema %}
{"name":"Artigo","settings":[]}
{% endschema %}
