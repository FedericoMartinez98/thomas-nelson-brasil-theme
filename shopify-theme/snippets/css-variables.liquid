{%- comment -%} Theme tokens from settings. {%- endcomment -%}
<style>
  :root{
    --bg:{{ settings.color_bg }};--surface:{{ settings.color_surface }};--ink:{{ settings.color_ink }};
    --muted:{{ settings.color_muted }};--line:{{ settings.color_line }};--brand:{{ settings.color_brand }};
    --brand-soft:{{ settings.color_brand_soft }};--accent:{{ settings.color_accent }};
    --sale:{{ settings.color_sale }};--success:{{ settings.color_success }};
    --logo-w:{{ settings.logo_width }}px;
  }
</style>
